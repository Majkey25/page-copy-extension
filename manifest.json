{
  "manifest_version": 3,
  "name": "Page Copy",
  "version": "1.2.1",
  "minimum_chrome_version": "120",
  "description": "Copy lossless screenshots or page source. Save complete ZIPs, offline MHTML, PDF, Markdown, JSON, HTML, TXT, and SVGs.",
  "homepage_url": "https://github.com/Majkey25/page-copy-extension",
  "permissions": ["activeTab", "debugger", "scripting", "clipboardWrite", "downloads", "offscreen"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Page Copy",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
  },
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
}
